}

1 early() {
	sim.addSubpop("p1", startingGenSize, sexRatio=(1-startingFreq));
	inds=p1.individuals;
	
	females=inds[inds.sex=="F"];
	males=inds[inds.sex=="M"];
	
	inds.haplosomesForChromosomes(1,0).addNewDrawnMutation(m1,locus);
	females.haplosomesForChromosomes(1,1).addNewDrawnMutation(m2,locus);
	females.haplosomesForChromosomes(3,0).addNewDrawnMutation(m5,locus);
	females.haplosomesForChromosomes(3,1).addNewDrawnMutation(m6,locus);//remove this SgRNA chromosome for the control cross
	
	males.haplosomesForChromosomes(3,0).addNewDrawnMutation(m5,locus);
	males.haplosomesForChromosomes(3,1).addNewDrawnMutation(m5,locus);
	
	defineGlobal("shi",sim.mutationsOfType(m1));	
	defineGlobal("shi_ts",sim.mutationsOfType(m2));
	defineGlobal("shi_R",sim.mutationsOfType(m3));	
	defineGlobal("Cas9",sim.mutationsOfType(m5));
	defineGlobal("sgRNA",sim.mutationsOfType(m6));
		
}

//// Reproduction rules for females
reproduction(NULL, "F") {	

	// Sterility check: If female parent has Cas9(m5) and sgRNA(m6) but NO m2, they are sterile
	female_has_drive = individual.countOfMutationsOfType(m5)>=1 & individual.countOfMutationsOfType(m6)>=1;
	female_has_m2 = individual.countOfMutationsOfType(m2)>=1;
	
	if (female_has_drive & !female_has_m2) {
		return;
	}
	
	// Fecundity based on population density
	capacity_fitness_scaling = 10 / (((10 - 1) * p1.individualCount / K) + 1);
	p = capacity_fitness_scaling * 2 / 50 / (1 + 0);
	num_offspring = rbinom(1, 50, p);
	
	for (i in 1:num_offspring) {
	selected_mate = subpop.sampleIndividuals(1, sex="M");
		
		// No available mates?
		if (!selected_mate.size())
			return;
		
		// Sterility check: If male parent has Cas9(m5) and sgRNA(m6) but NO m2, they are sterile
		male_has_drive = selected_mate.countOfMutationsOfType(m5)>=1 & selected_mate.countOfMutationsOfType(m6)>=1;
		male_has_m2 = selected_mate.countOfMutationsOfType(m2)>=1;
		
		if (male_has_drive & !male_has_m2) {
			// If male is sterile, skip and try another male
			next;
		}
		
		// Add offspring if both parents pass sterility check
		offspring = subpop.addCrossed(individual, selected_mate);
	}
}

1: modifyChild() {
	if(!(size(sgRNA) & size(shi) & size(Cas9))){;
		return T;
	}

	// Germline Cas9 cutting
	germline(child.haplosomesForChromosomes(1, 0, includeNulls=F), parent1);
	if (size(child.haplosomesForChromosomes(1, 1, includeNulls=F)))
		germline(child.haplosomesForChromosomes(1, 1, includeNulls=F), parent2);
	
	// Embryonic Cas9 cutting
	embryonic(child.haplosomesForChromosomes(1, 0, includeNulls=F), parent1);
	if (size(child.haplosomesForChromosomes(1, 1, includeNulls=F)))
		embryonic(child.haplosomesForChromosomes(1, 1, includeNulls=F), parent1);
	
	// Embryonic lethality (kill embryos with m1 from Cas9+sgRNA mothers)
mother_has_drive = any(parent1.countOfMutationsOfType(m5)>=1) & any(parent1.countOfMutationsOfType(m6)>=1);
child_has_m1 = any(child.countOfMutationsOfType(m1)>=1);
if (mother_has_drive & child_has_m1 & runif(1) < embryonicCas9Eff) {
	return F;
}
	
	// Recessive lethality of m3 (NHEJ shibire allele)
	if (child.sex == "M" & child.countOfMutationsOfType(m3) >= 1) {
		return F;
	}	
	if (child.sex == "F" & child.countOfMutationsOfType(m3) == 2) {
		return F;
	}
	return T;
}


// Germline Cas9 cutting: Mother must have Cas9, sgRNA, and m1
function (void) germline (o<Haplosome>$ childcr , o<Individual>$ parent) {
	parent_sgRNA = any(parent.countOfMutationsOfType(m6)>=1);
	parent_cas9 = any(parent.countOfMutationsOfType(m5)>=1);
	child_wt = any(childcr.containsMarkerMutation(m1, locus));
	
	if (child_wt & parent_sgRNA & parent_cas9 & runif(1) < germlineCas9Eff) {
		// Define repair pathway
		if (runif(1) < HDR_Rate) {
			// HDR = m1 to m2
			childcr.removeMutations(childcr.mutationsOfType(m1));
			childcr.addNewDrawnMutation(m2, locus);
		} else {
			// NHEJ = m1 to m3
			childcr.removeMutations(childcr.mutationsOfType(m1));
			childcr.addNewDrawnMutation(m3, locus);
		}
	}
}

// Embryonic Cas9 cutting: Mother with Cas9 and sgRNA kills embryos with m1
function (void) embryonic (o<Haplosome>$ childcr, o<Individual>$ mother ) {
	mother_has_drive = any(mother.countOfMutationsOfType(m5)>=1) & any(mother.countOfMutationsOfType(m6)>=1);
	child_has_m1 = any(childcr.containsMarkerMutation(m1, locus));
	
