function (void) defineParameter(s$ name, lifs default){
	if(!exists(name)){
		defineConstant(name,default);
	}
}

function(void) writeData(void) {
	males = p1.subsetIndividuals(sex='M');
	females = p1.subsetIndividuals(sex='F');
	
	// Frequency of m2 allele in males
	m2_freq_males = sum(males.countOfMutationsOfType(m2)) / size(males);

	
//Headers for csv:
//Seed,Cycle,PopSize,Females,Males,Offspring,OffspringFemales,OffspringMales,m1_freq,m2_freq,m2_freq_males,m3_freq,Cas9_freq,sgRNA_freq,prop_m2m2_females,germlineCas9Eff,embryonicCas9Eff,HDR_Rate",

	writeFile(outputFilePath,
		asString(getSeed()) + "," +
			asString(sim.cycle) + "," +
			asString(size(p1.individuals)) + "," +
			asString(size(females)) + "," +
			asString(size(males)) + "," +
			asString(num_offspring) + "," +
			asString(num_offspring_females) + "," +
			asString(num_offspring_males) + "," +
			asString(sum(sim.mutationFrequencies(p1,sim.mutationsOfType(m1)))) + "," +
			asString(sum(sim.mutationFrequencies(p1,sim.mutationsOfType(m2)))) + "," +
			asString(m2_freq_males) + "," +	
			asString(sum(sim.mutationFrequencies(p1,sim.mutationsOfType(m3)))) + "," +
			asString(sum(sim.mutationFrequencies(p1,sim.mutationsOfType(m5)))) + "," +
			asString(sum(sim.mutationFrequencies(p1,sim.mutationsOfType(m6)))) + "," +
			asString(prop_m2m2_females)+ "," +
			asString(germlineCas9Eff_param) + "," +
			asString(embryonicCas9Eff_param) + "," +
			asString(HDR_Rate_param),	
		append = T);
}

