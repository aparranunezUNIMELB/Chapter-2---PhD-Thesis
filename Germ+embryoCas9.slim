}

late() {
	if(p1.individualCount==0){
		sim.simulationFinished();
	}
	
	// Sex ratio check and crash population if males > 95%
	males = p1.subsetIndividuals(sex='M');
	females = p1.subsetIndividuals(sex='F');
	male_proportion = size(males) / p1.individualCount;
	
	if (male_proportion > 0.95) {
		catn("Population crashed: insufficient females");
		sim.killIndividuals(p1.individuals);
		sim.simulationFinished();
		return;
	}
	
	// Count offspring before culling
	all_before_culling = p1.individuals;
	offspring_age_0 = all_before_culling[all_before_culling.age == 0];
	males_offspring = offspring_age_0[offspring_age_0.sex == "M"];
	females_offspring = offspring_age_0[offspring_age_0.sex == "F"];
	
	defineGlobal("num_offspring", size(offspring_age_0));
	defineGlobal("num_offspring_males", size(offspring_age_0[offspring_age_0.sex == "M"]));
	defineGlobal("num_offspring_females", size(offspring_age_0[offspring_age_0.sex == "F"]));
	// Count m1/m2 genotypes
m1m1_females = sum(females_offspring.countOfMutationsOfType(m1) == 2);
m1m2_females = sum((females_offspring.countOfMutationsOfType(m1) == 1) & (females_offspring.countOfMutationsOfType(m2) == 1));
m2m2_females = sum(females_offspring.countOfMutationsOfType(m2) == 2);

m1_males = sum(males_offspring.countOfMutationsOfType(m1) == 1);
m2_males = sum(males_offspring.countOfMutationsOfType(m2) == 1);

// Proportion of m2/m2 females before culling
prop_m2m2_females = m2m2_females / size(females_offspring);
defineGlobal("prop_m2m2_females", prop_m2m2_females);

// Count m3 females
m3m1_females = sum((females_offspring.countOfMutationsOfType(m3) == 1) & (females_offspring.countOfMutationsOfType(m1) == 1));
m3m2_females = sum((females_offspring.countOfMutationsOfType(m3) == 1) & (females_offspring.countOfMutationsOfType(m2) == 1));
m3m3_females = sum(females_offspring.countOfMutationsOfType(m3) == 2);

// Offspring Genotype Counts
catn("----- GENERATION " + sim.cycle + " -----");
catn("Total offspring: " + num_offspring);
catn("");
catn("FEMALES (" + size(females_offspring) + " total):");
catn("  m1/m1: " + m1m1_females);
catn("  m1/m2: " + m1m2_females);
catn("  m2/m2: " + m2m2_females);
catn("  m3/m1: " + m3m1_females);
catn("  m3/m2: " + m3m2_females);
catn("  m3/m3: " + m3m3_females);

catn("");
catn("MALES (" + size(males_offspring) + " total):");
catn("  m1: " + m1_males);
catn("  m2: " + m2_males);

// Count m3 males
m3_males = sum(males_offspring.countOfMutationsOfType(m3) == 1);
catn("  m3: " + m3_males);

catn("");
catn("SEX RATIO: " + size(females_offspring) + " females : " + size(males_offspring) + " males");
catn("");
	all = sim.subpopulations.individuals;
	sim.killIndividuals(all[all.age>=1]);
	sim.killIndividuals(sample(all[all.age==0],max(size(all[all.age==0])-nextGenSize,0)));
	
	defineGlobal("shi",sim.mutationsOfType(m1));	
	defineGlobal("shi_ts",sim.mutationsOfType(m2));
	defineGlobal("shi_R",sim.mutationsOfType(m3));	
	defineGlobal("Cas9",sim.mutationsOfType(m5));
	defineGlobal("sgRNA",sim.mutationsOfType(m6));		

	writeData();
}
