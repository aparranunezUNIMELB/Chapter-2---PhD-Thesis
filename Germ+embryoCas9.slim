initialize() {
	initializeSLiMModelType("nonWF");
		
    defineParameter("outputFilePath", "/Users/anakarla/Desktop/files phd/TempSens/SLIM/temp.csv"); 
	
	// Population parameters
	defineParameter("K", 500); //500 for bottles (Figure 2.5), 100 for vials (Figure 2.4)
	defineParameter("startingGenSize",50); //50 for bottles (Figure 2.5), 8 for vials (Figure 2.4)
	defineParameter("nextGenSize",100); //100 for bottles (Figure 2.5), N/A for vials (Figure 2.4)
	
	initializeSex();
	
	//Drive and resistance parameters
	defineParameter("locus",0);
	defineParameter("startingFreq",0.75); //0.5 for bottles (Figure 2.5), 0.75 for vials (Figure 2.4)

	defineParameter("embryonicCas9Eff",0);
	defineParameter("germlineCas9Eff", 0.8);
	defineParameter("HDR_Rate",0.1);

	// Wildtype X shibire allele (Suceptible to CRISPR-cas9)
	shi = initializeMutationType("m1", 0.5, "f", 0.0);
	m1.convertToSubstitution = F;

	// Temperatue sensitive shibire allele (Resistant to CRISPR-cas9)
	shi_ts = initializeMutationType("m2", 0.5, "f", 0.0); 
	m2.convertToSubstitution = F;	
	
	// NHEJ shibire allele (Resistant to CRISPR-cas9)
	shi_R = initializeMutationType("m3", 0.5, "f", 0.0); 
	m3.convertToSubstitution = F;	
	
	initializeGenomicElementType("g1", c(m1,m2,m3), c(1,1,1));
	initializeChromosome(1, 1, type="X", symbol="X");
	initializeGenomicElement(g1);
	initializeMutationRate(0);
	initializeRecombinationRate(0);
	
	wt_y = initializeMutationType("m4", 0.5, "f", 0.0); 
	m4.convertToSubstitution = F;
	initializeGenomicElementType("g2", m2 , 1.0);
	initializeChromosome(2, 1, type="Y", symbol="Y");
	initializeGenomicElement(g2);
	initializeMutationRate(0);

	// Cas9
	Cas9 = initializeMutationType("m5", 0.5, "f", 0.0); 
	m5.convertToSubstitution = F;

	// sgRNA
	sgRNA = initializeMutationType("m6", 0.5, "f", 0.0);
	m6.convertToSubstitution = F;
	
	initializeGenomicElementType("g3", c(m5,m6), c(1,1));
	initializeChromosome(3, 1, type="A", symbol="A");
	initializeGenomicElement(g3);
	initializeMutationRate(0);
	initializeRecombinationRate(0);

	TS_variations = c(m1, m2, m3);
	TS_variations.mutationStackPolicy = "s"; 
	TS_variations.mutationStackGroup = 1;

	drive_variations = c(m5, m6);
	drive_variations.mutationStackPolicy = "l"; 
	drive_variations.mutationStackGroup = 2;
	
	// Make parameters global for output
	defineGlobal("germlineCas9Eff_param", germlineCas9Eff);
	defineGlobal("embryonicCas9Eff_param", embryonicCas9Eff);
	defineGlobal("HDR_Rate_param", HDR_Rate);
}

